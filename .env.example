# MeetFlow AI Environment Configuration

# Backend Configuration
PROJECT_NAME="MeetFlow AI"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database (Default is local SQLite, supports postgresql://user:pass@host/db)
DATABASE_URL="sqlite:///./meetflow.db"

# LLM / AI Provider
# If OPENAI_API_KEY is not set or set to "mock", the built-in deterministic AI engine will be used
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Trello Integration (Optional)
# Leave empty to use MeetFlow AI's built-in task tracker
TRELLO_API_KEY=""
TRELLO_TOKEN=""
TRELLO_LIST_ID=""

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
